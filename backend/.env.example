# Pega aquí la cadena de conexión de tu base de datos Neon (https://neon.tech)
DATABASE_URL="postgresql://usuario:password@host.neon.tech/huellitas?sslmode=require"

# Secreto para firmar los tokens JWT (cámbialo en producción)
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Puerto del servidor
PORT=4000

# URL del frontend (para CORS en producción, ej: https://tu-app.vercel.app)
FRONTEND_URL="http://localhost:5173"

# Contraseñas de las cuentas demo que crea el seed (nunca las publiques en el repo)
SEED_PASS_VET="escribe-aqui-una-clave"
SEED_PASS_RECEPCION="escribe-aqui-una-clave"
SEED_PASS_CLIENTE="escribe-aqui-una-clave"
